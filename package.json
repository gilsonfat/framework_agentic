{
  "name": "@agentic/sdlc-orchestrator",
  "version": "1.2.1",
  "description": "Agentic SDLC Orchestrator - deterministic, state-driven delivery framework with evidence-gated closure for AI coding agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentic": "./bin/agentic.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node bin/agentic.js doctor",
    "status": "node bin/agentic.js status",
    "observe": "node bin/agentic.js observe",
    "reconcile": "node bin/agentic.js reconcile",
    "init:agentic": "node scripts/agentic-init.js",
    "prepublishOnly": "npm run build && npm test",
    "migrate": "node bin/agentic.js migrate",
    "verify:self": "node bin/agentic.js doctor && node bin/agentic.js audit verify"
  },
  "keywords": [
    "agentic",
    "ai-agents",
    "antigravity",
    "claude-code",
    "codex",
    "evidence-gated",
    "gemini-cli",
    "gsd",
    "multi-agent",
    "orchestrator",
    "ruflo",
    "sdlc",
    "state-machine",
    "superpowers",
    "tlc"
  ],
  "author": "Gilson Santana",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilsonfat/framework_agentic.git"
  },
  "bugs": {
    "url": "https://github.com/gilsonfat/framework_agentic/issues"
  },
  "homepage": "https://github.com/gilsonfat/framework_agentic#readme",
  "files": [
    "dist",
    "bin",
    ".agentic/orchestrator",
    ".agentic/prompts",
    ".agentic/templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/ARCHITECTURE.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
