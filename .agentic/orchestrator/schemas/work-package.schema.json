{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkPackage",
  "type": "object",
  "required": [
    "run_id",
    "milestone",
    "phase",
    "goal",
    "scope",
    "requirements",
    "complexity"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "milestone": { "type": "string" },
    "phase": { "type": "string" },
    "goal": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "complexity": {
      "type": "string",
      "enum": ["XS", "S", "M", "L", "XL"]
    },
    "expected_domains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_gate_required": { "type": "boolean" }
  }
}
