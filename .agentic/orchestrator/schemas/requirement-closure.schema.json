{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequirementClosureMatrix",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["implemented", "tested", "verified", "tasks"],
    "properties": {
      "implemented": { "type": "boolean" },
      "tested": { "type": "boolean" },
      "verified": { "type": "boolean" },
      "tasks": {
        "type": "array",
        "items": { "type": "string" }
      },
      "files": {
        "type": "array",
        "items": { "type": "string" }
      },
      "tests": {
        "type": "array",
        "items": { "type": "string" }
      },
      "commits": {
        "type": "array",
        "items": { "type": "string" }
      },
      "verification": { "type": "string" }
    }
  }
}
