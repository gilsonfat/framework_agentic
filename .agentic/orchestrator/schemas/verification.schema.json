{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationReport",
  "type": "object",
  "required": [
    "verification_id",
    "run_id",
    "status",
    "timestamp",
    "requirements_checked",
    "evidence"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "pattern": "^VER-[0-9A-Za-z_-]+$"
    },
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PARTIAL"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "verifier_type": {
      "type": "string",
      "enum": ["fresh_context", "local", "automated"]
    },
    "requirements_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "status"],
        "properties": {
          "requirement_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["verified", "failed", "untested"]
          },
          "acceptance_criteria_passed": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance_criteria_failed": {
            "type": "array",
            "items": { "type": "string" }
          },
          "findings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["tests_passed", "tests_failed"],
      "properties": {
        "tests_passed": { "type": "integer" },
        "tests_failed": { "type": "integer" },
        "test_suite_output": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
