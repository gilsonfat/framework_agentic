{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskContract",
  "type": "object",
  "required": [
    "id",
    "role",
    "objective",
    "requirements",
    "acceptance_criteria",
    "ownership",
    "process",
    "output",
    "completion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9A-Za-z_-]+$"
    },
    "title": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "write"
      ],
      "properties": {
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readonly": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "tdd": {
          "type": "boolean"
        },
        "systematic_debugging": {
          "type": "boolean"
        },
        "verification_before_completion": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "implementation_report": {
          "type": "boolean"
        },
        "tests": {
          "type": "boolean"
        },
        "commit": {
          "type": "boolean"
        }
      }
    },
    "completion": {
      "type": "object",
      "properties": {
        "tests_must_pass": {
          "type": "boolean"
        },
        "no_self_declared_done": {
          "type": "boolean"
        }
      }
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Artifact schema version. Absent means v1 (written before versioning existed)."
    }
  }
}
